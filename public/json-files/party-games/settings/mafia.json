{
  "mafia-settings": [
    {
      "settings-name": "anonymous-vote",
      "settings-description": "Hides each player’s individual vote so the town can see the result without knowing who voted for whom.",
      "settings-colour": "var(--primarypagecolour)",
      "settings-secondary-colour": "var(--secondarypagecolour)",
      "settings-restriction": ["nsfw"],
      "settings-active": true,
      "button-type": "toggle",
      "applies-to": ["mafia"]
    },
    {
      "settings-name": "day-timer",
      "settings-description": "Sets how long the town has to discuss suspicions and decide who should be eliminated during each day.",
      "settings-colour": "var(--backgroundcolour)",
      "settings-secondary-colour": "var(--secondarybackgroundcolour)",
      "settings-restriction": ["nsfw"],
      "settings-active": true,
      "button-type": "increment",
      "applies-to": ["mafia"],
      "button-designation": "neautral",
      "button-initial-value": 60,
      "button-increment-value": 30,
      "button-minimum-value": 30,
      "button-maximum-value": 600
    },
    {
      "settings-name": "death-reveal",
      "settings-description": "Reveals the secret role of a player after they are killed or voted out.",
      "settings-colour": "var(--primarypagecolour)",
      "settings-secondary-colour": "var(--secondarypagecolour)",
      "settings-restriction": ["nsfw"],
      "settings-active": true,
      "button-type": "toggle",
      "applies-to": ["mafia"]
    },
    {
      "settings-name": "night-timer",
      "settings-description": "Sets how long the Mafia and other active roles have to complete their decisions during each night.",
      "settings-colour": "var(--backgroundcolour)",
      "settings-secondary-colour": "var(--secondarybackgroundcolour)",
      "settings-restriction": ["nsfw"],
      "settings-active": true,
      "button-type": "increment",
      "applies-to": ["mafia"],
      "button-designation": "neautral",
      "button-initial-value": 60,
      "button-increment-value": 30,
      "button-minimum-value": 30,
      "button-maximum-value": 600
    }
  ]
}
